      (pins X2-4 U3-2 R8-2 LED1-C LED1-C@1 D12-2 D9-2 D3-2 C3-2)
    )
    (net "Net-(U3-STAT)"
      (pins U3-1 R2-2)
    )
    (net VBAT
      (pins X2-2 U3-3 S1-3 D11-1 D7-1 D1-1 C3-1)
    )
    (net VBUS
      (pins U3-4 CHG0-A)
    )
    (net "Net-(U3-PROG)"
      (pins U3-5 R8-1)
    )
    (net VBAT_ON
      (pins S1-4)
    )
    (net "Net-(D7-A)"
      (pins X2-3 D9-1 D7-2)
    )
    (net VLED
      (pins S1-1 R15-1)
    )
    (net "unconnected-(S1-Pad2)"
      (pins S1-2)
    )
    (net "Net-(D1-A)"
      (pins X2-5 D3-1 D1-2)
    )
    (net "Net-(LED1-PadA)"
      (pins R15-2 LED1-A LED1-A@1)
    )
    (net "Net-(D11-A)"
      (pins X2-1 D12-1 D11-2)
    )
    (net "unconnected-(X2F-S-Pad6)"
      (pins X2-6)
    )
    (net "Net-(CHG0-PadC)"
      (pins R2-1 CHG0-C)
    )
    (class kicad_default GND "Net-(CHG0-PadC)" "Net-(D1-A)" "Net-(D11-A)"
      "Net-(D7-A)" "Net-(LED1-PadA)" "Net-(U3-PROG)" "Net-(U3-STAT)" VBAT
      VBAT_ON VBUS VLED "unconnected-(S1-Pad2)" "unconnected-(X2F-S-Pad6)"
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
